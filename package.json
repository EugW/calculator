{
    "name": "genshin_impact_calculator",
    "version": "3.7.0",
    "draft_version": "0.6.19",
    "private": true,
    "scripts": {
        "build": "npm run build:lang && webpack --mode=production",
        "build:lang": "python bin/gen_string_table.py base casino",
        "watch": "npm run build:lang && webpack --mode=development --watch",
        "serve": "webpack serve --mode=development",
        "build:draft": "npm run build:draft:lang && webpack --config ./webpack.config.draft.js --mode=production",
        "build:draft:lang": "python bin/gen_string_table.py draft",
        "watch:draft": "npm run build:draft:lang && webpack --config ./webpack.config.draft.js --mode=development --watch",
        "dev:backend": "cd backend && bun run index.ts",
        "dev": "npm run build:lang && npx concurrently -n webpack,backend -c cyan,green \"webpack --mode=development --watch\" \"npm run dev:backend\"",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "test:gpu": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js test/gpuFusedNode.test.js"
    },
    "jest": {
        "cache": false,
        "verbose": true,
        "testRegex": ".*\\.test\\.js$",
        "rootDir": "./test/",
        "transform": {
            "^.+\\.jsx?$": [
                "babel-jest",
                {
                    "configFile": "./babel-jest.config.js"
                }
            ]
        }
    },
    "dependencies": {
        "core-js": "^3.48.0",
        "file-saver": "^2.0.5",
        "jquery": "",
        "js-levenshtein": "^1.1.6",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-intersection-observer": "^11.0.1",
        "react-sortablejs": "^6.1.4",
        "regenerator-runtime": "^0.14.1",
        "simplebar": "^6.3.3",
        "simplebar-react": "^3.3.2",
        "sortablejs": "^1.15.7",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/plugin-transform-modules-commonjs": "^7.28.6",
        "@babel/plugin-transform-react-constant-elements": "^7.27.1",
        "@babel/plugin-transform-react-inline-elements": "^7.27.1",
        "@babel/plugin-transform-runtime": "^7.29.0",
        "@babel/preset-env": "^7.29.0",
        "@babel/preset-react": "^7.28.5",
        "@babel/runtime": "^8.0.0",
        "@types/extract-text-webpack-plugin": "^3.0.10",
        "ajv": "^8.17.1",
        "babel-jest": "^30.2.0",
        "babel-loader": "^10.0.0",
        "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.3",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "html-react-parser": "^6.1.7",
        "html-webpack-plugin": "^5.6.6",
        "jest": "^30.2.0",
        "mini-css-extract-plugin": "^2.10.0",
        "npm-watch": "^0.13.0",
        "style-loader": "^4.0.0",
        "terser-webpack-plugin": "^5.6.1",
        "webgpu": "^0.6.1",
        "webpack": "^5.105.2",
        "webpack-cli": "^7.2.3",
        "webpack-dev-server": "^6.0.0"
    }
}
